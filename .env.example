# Copy to .env and replace every REPLACE_WITH_* value before production use.
NODE_ENV=production

# Application and database credentials
SESSION_SECRET=REPLACE_WITH_SESSION_SECRET
DB_USER=hotbando
DB_PASSWORD=REPLACE_WITH_APPLICATION_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_MYSQL_ROOT_PASSWORD
DB_HOST=db
DB_PORT=3306
DB_NAME=hotbando

# Cache
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# Router, provisioning, and encryption
MIKROTIK_API_PASSWORD=REPLACE_WITH_CURRENT_ROUTER_API_PASSWORD
MIKROTIK_DEFAULT_PASSWORD=REPLACE_WITH_ROUTER_ONBOARDING_PASSWORD
HOTSPOT_ADMIN_PASSWORD=REPLACE_WITH_HOTSPOT_ADMIN_PASSWORD
RADIUS_SECRET=REPLACE_WITH_RADIUS_SHARED_SECRET
ROUTER_REGISTRATION_SECRET=REPLACE_WITH_ROUTER_REGISTRATION_SECRET
COLLECTOR_KEY=REPLACE_WITH_COLLECTOR_KEY
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTER_ENCRYPTION_KEY

# ClickPesa credentials
CLICKPESA_CLIENT_ID=REPLACE_WITH_CLICKPESA_CLIENT_ID
CLICKPESA_API_KEY=REPLACE_WITH_CLICKPESA_API_KEY
CLICKPESA_CHECKSUM_KEY=REPLACE_WITH_CLICKPESA_CHECKSUM_KEY
CLICKPESA_WEBHOOK_SECRET=REPLACE_WITH_CLICKPESA_WEBHOOK_SECRET
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties
CLICKPESA_TEST_MODE=false
CLICKPESA_WEBHOOK_RATE_LIMIT_MAX=60
CLICKPESA_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
CLICKPESA_WEBHOOK_MAX_BODY_BYTES=1mb

# Only used if database/seed.js or database/seed-minimal.js is run
SEED_PASSWORD=REPLACE_WITH_SEED_ACCOUNT_PASSWORD
